extends ../layout/artica
block title
  title Artica | Targo
  
block content
  main.main#barba-wrapper
    .barba-container#projectPreview(data-order='3' data-label='identity')
      .page-block.project-preview
        .container.container_display-size
          .container__inner
            .container__content.project-preview__container
              .project-preview__image.project-preview__item.hover-area
                a(href="#").project-preview__link.cover-box.cover-box_size-auto.ajax-link.project-link.hover-child
                  img(data-src="img/images/image2.svg", alt="image2").lazy
              h1.project-preview__title.project-preview__item TARGO
              span.project-preview__line.project-preview__item
              p.project-preview__description.project-preview__item.t-size-36 TARGO logistics.<br> Logotype design