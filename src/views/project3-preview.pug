extends layout/artica
block content
  main.main#barba-wrapper
    .barba-container#projectPreview(data-order='4' data-label='graphic')
      .page-block.project-preview
        .container.container_type-1
          .project-preview__container.content
            .project-preview__image
              a(href="project3.html" data-label='graphic').project-preview__link.cover-box.cover-box_size-auto.ajax-link
                img(data-src="img/images/image3.jpg", alt="image3").lazy
            h1.project-preview__title PATRON
            span.project-preview__line
            p.project-preview__description B&W print cartridges<br> Identity and graphic<br> design.
