extends ../layout/artica
block title
  title Artica | Navigator
  
block content
  main.main#barba-wrapper
    .barba-container#projectPreview(data-order='5' data-label='graphic')
      .page-block.project-preview
        .container.container_display-size
          .container__inner
            .container__content.project-preview__container
              .project-preview__image.project-preview__item.hover-area
                a(href="#").project-preview__link.cover-box.cover-box_size-auto.hover-child
                  img(data-src="img/images/image3.jpg", alt="image3").lazy
              h1.project-preview__title.project-preview__item NAVIGATOR
              span.project-preview__line.project-preview__item
              p.project-preview__description.project-preview__item.t-size-36 B&W print cartridges<br> Identity and graphic<br> design.
