extends ../layout/artica
block title
  title Artica | Route66
  
block content
  main.main#barba-wrapper
    .barba-container#projectPreview(data-order='2' data-label='identity')
      .page-block.project-preview
        .container.container_display-size
          .container__inner
            .container__content.project-preview__container
              .project-preview__image.project-preview__item.hover-area
                a(href="#" data-label='identity').project-preview__link.cover-box.cover-box_size-auto.ajax-link.project-link.hover-child
                  img(data-src="img/images/image1.jpg", alt="image1").lazy
              h1.project-preview__title.project-preview__item ROUTE 66
              span.project-preview__line.project-preview__item
              p.project-preview__description.project-preview__item.t-size-36 R66 route diner style,<br> logos and prints
              .project-preview__demo.project-preview__item
                a(href="http://route66.ru/" target='_blank').link route66.ru
